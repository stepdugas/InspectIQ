# Staging Environment Variables
# Set these in Vercel Dashboard > Settings > Environment Variables
# Scope: "Preview" only (NOT Production)
#
# HOW TO SET UP:
# 1. Create a Neon database branch (see below)
# 2. Copy these into Vercel with scope = Preview
# 3. Push the "staging" branch to trigger a preview deploy
# 4. Every push to staging gets its own preview URL

# --- DATABASE (Neon branch) ---
# Go to console.neon.tech > your project > Branches > Create Branch
# Name it "staging", branch from "main"
# Copy the connection string here
DATABASE_URL=postgresql://...@ep-staging-branch.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- AUTH (Clerk) ---
# Option A: Use same Clerk keys (shares user accounts with prod — simpler)
# Option B: Create a separate Clerk "Staging" instance (fully isolated)
# For now, use the same keys — you can isolate later
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- AI ---
# Same Anthropic key is fine (staging usage will be minimal)
ANTHROPIC_API_KEY=sk-ant-...

# --- PAYMENTS (Stripe TEST mode) ---
# Use Stripe TEST keys so no real charges happen on staging
# Dashboard > Developers > API Keys > toggle "Test mode"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_... (create a separate webhook for staging URL)
STRIPE_PRICE_ID=price_... (create a test price in Stripe test mode)

# --- EMAIL ---
# Same Resend key is fine — staging emails will go to your own test addresses
RESEND_API_KEY=re_...

# --- FILE STORAGE ---
# Same Cloudinary account is fine (staging uploads go to same bucket)
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# --- APP ---
# Vercel auto-sets NEXT_PUBLIC_VERCEL_URL for preview deploys
# This env var is only needed if code references it directly
NEXT_PUBLIC_APP_URL=https://inspectiq-staging.vercel.app

# --- ADMIN ---
ADMIN_EMAIL=stepdugas@gmail.com
ADMIN_PASSWORD=staging-only-password-here
ADMIN_COOKIE_SECRET=generate-a-random-32-char-string

# --- CRON ---
# Vercel crons only run on production — staging is safe
CRON_SECRET=staging-cron-secret

# --- ENCRYPTION (ISN passwords) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=64-char-hex-string-here

# --- PERMITS (Shovels.ai) ---
# Free tier: 250 API calls. Sign up at shovels.ai
# If not set, the permit brief will show empty results gracefully
SHOVELS_API_KEY=

# --- ISN ---
NEXT_PUBLIC_ISN_ENABLED=true
